# Database (Supabase — use pooler URL for app, direct for migrations)
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-xx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_URL_DIRECT="postgresql://postgres.xxxx:password@db.xxxx.supabase.co:5432/postgres"

# Auth.js
AUTH_SECRET="generate-with-npx-auth-secret"
NEXTAUTH_URL="http://localhost:3000"

# Microsoft Entra ID (optional — good-to-have 5.1)
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# Resend (email — good-to-have 5.2a)
RESEND_API_KEY=""
EMAIL_FROM="AtomQuest Portal <onboarding@resend.dev>"

# Supabase Realtime (for completion dashboard live updates)
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Cron secret (set same value in Vercel dashboard → Settings → Environment Variables)
CRON_SECRET=""

# Feature flags
NEXT_PUBLIC_DEMO_MODE="true"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
